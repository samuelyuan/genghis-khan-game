{
  "name": "genghis-khan-game",
  "version": "1.0.0",
  "description": "A HTML5 and Javascript remake of the Flash game \"Genghis Khan\"",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "build": "node build.js",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "dev:full": "npm run build && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "jsvectormap": "^1.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelyuan/genghis-khan-game.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samuelyuan/genghis-khan-game/issues"
  },
  "homepage": "https://github.com/samuelyuan/genghis-khan-game#readme",
  "private": true
}
